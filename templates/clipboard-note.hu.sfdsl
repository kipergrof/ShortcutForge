#name "Vágólap jegyzetbe"
#icon color=gold glyph=59511

clip = GetClipboard()
now = Date(mode: "Current Date")
stamp = FormatDate(now, dateFormat: "Short", timeFormat: "Short")
AppendToFile("{stamp}: {clip}", path: "Shortcuts/jegyzetek.txt", mode: "Append")
Notification("Elmentve a jegyzetek közé.", title: "Vágólap")
