<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\ShortcutForge.Core\ShortcutForge.Core.csproj" />
    <ProjectReference Include="..\ShortcutForge.Dsl\ShortcutForge.Dsl.csproj" />
    <ProjectReference Include="..\ShortcutForge.Signing\ShortcutForge.Signing.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Anthropic" Version="12.50.0" />
    <PackageReference Include="AvalonEdit" Version="6.3.1.120" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="QRCoder" Version="1.8.0" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="10.0.12" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationIcon>Assets/app.ico</ApplicationIcon>
    <AssemblyTitle>ShortcutForge</AssemblyTitle>
    <Product>ShortcutForge</Product>
    <!-- Application.ThemeMode (Fluent light/dark) is marked experimental -->
    <NoWarn>$(NoWarn);WPF0001</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets/app.ico" />
    <Resource Include="Assets/shortcuty.png" />
  </ItemGroup>

</Project>
