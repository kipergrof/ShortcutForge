<Window Icon="/Assets/app.ico" x:Class="ShortcutForge.App.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:ShortcutForge.App.Services"
        Title="{l:T 'Beállítások – aláírás', 'Settings – signing'}" Width="600" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource WindowBg}" Foreground="{DynamicResource TextFg}" FontFamily="Segoe UI" FontSize="13">
    <StackPanel Margin="16">
        <TextBlock Text="{l:T 'Exportáláskor a parancs aláírása', 'Signing the shortcut on export'}" FontWeight="SemiBold" FontSize="14" />
        <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource MutedText}" Margin="0,4,0,8"
                   Text="{l:T 'iOS 15 óta az iPhone, iPad és Mac csak Apple által aláírt .shortcut fájlt importál. Aláírni csak macOS-en lehet (shortcuts sign). Ha van elérhető Maced (saját vagy bérelt felhős Mac), az alkalmazás SSH-n keresztül aláírja a fájlt.', 'Since iOS 15, iPhone, iPad and Mac only import .shortcut files signed by Apple. Signing is only possible on macOS (shortcuts sign). If you have access to a Mac (your own or a rented cloud Mac), the app signs the file over SSH.'}" />

        <RadioButton x:Name="ShortcutyRadio" GroupName="Signer" Margin="0,4" FontWeight="SemiBold"
                     Content="{l:T 'Ingyenes online aláírás – Shortcuty (ajánlott, Mac nem kell)', 'Free online signing – Shortcuty (recommended, no Mac needed)'}" />
        <TextBlock Margin="28,0,0,6" TextWrapping="Wrap" Foreground="{DynamicResource MutedText}" FontSize="11"
                   Text="{l:T 'A sign.shortcuty.app nyilvános API-ja írja alá („bárki” módban). A parancs teljes tartalma a Shortcuty szerverére kerül, ezért jelszót, API-kulcsot vagy személyes adatot tartalmazó parancsot ne írass alá így.', 'Signed by the public sign.shortcuty.app API (anyone mode). The full shortcut is sent to Shortcuty, so do not sign shortcuts containing passwords, API keys or personal data this way.'}" />
        <RadioButton x:Name="UnsignedRadio" GroupName="Signer" Margin="0,4" Content="{l:T 'Aláírás nélküli export (később Macen aláírandó)', 'Unsigned export (sign later on a Mac)'}" />
        <RadioButton x:Name="ServerRadio" GroupName="Signer" Margin="0,4"
                     Content="{l:T 'Aláíró szerver (shortcut-signing-server kompatibilis URL)', 'Signing server (shortcut-signing-server compatible URL)'}" />
        <StackPanel Margin="28,2,0,6" IsEnabled="{Binding IsChecked, ElementName=ServerRadio}">
            <TextBox x:Name="ServerUrlBox" />
            <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource MutedText}" FontSize="11" Margin="0,4,0,0"
                       Text="{l:T 'Pl. saját Macen futó github.com/scaxyz/shortcut-signing-server. Figyelem: a parancs tartalma erre a szerverre kerül.', 'E.g. github.com/scaxyz/shortcut-signing-server running on your own Mac. Note: the shortcut content is sent to this server.'}" />
        </StackPanel>
        <RadioButton x:Name="MacRadio" GroupName="Signer" Margin="0,4" Content="{l:T 'Aláírás Macen, SSH-n keresztül', 'Sign on a Mac over SSH'}" />

        <Border Background="{DynamicResource PanelBg}" CornerRadius="8" Padding="12" Margin="0,8,0,0"
                IsEnabled="{Binding IsChecked, ElementName=MacRadio}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="150" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Text="{l:T 'Mac címe (host/IP):', 'Mac address (host/IP):'}" VerticalAlignment="Center" />
                <TextBox x:Name="HostBox" Grid.Column="1" Margin="0,3" />
                <TextBlock Grid.Row="1" Text="Port:" VerticalAlignment="Center" />
                <TextBox x:Name="PortBox" Grid.Row="1" Grid.Column="1" Margin="0,3" Width="90" HorizontalAlignment="Left" />
                <TextBlock Grid.Row="2" Text="{l:T 'Felhasználó:', 'User:'}" VerticalAlignment="Center" />
                <TextBox x:Name="UserBox" Grid.Row="2" Grid.Column="1" Margin="0,3" />
                <TextBlock Grid.Row="3" Text="{l:T 'Jelszó:', 'Password:'}" VerticalAlignment="Center" />
                <PasswordBox x:Name="PasswordBox" Grid.Row="3" Grid.Column="1" Margin="0,3" />
                <TextBlock Grid.Row="4" Text="{l:T 'vagy SSH kulcs:', 'or SSH key:'}" VerticalAlignment="Center" />
                <DockPanel Grid.Row="4" Grid.Column="1" Margin="0,3">
                    <Button DockPanel.Dock="Right" Style="{StaticResource ToolButton}" Click="BrowseKey_Click" Content="{l:T 'Tallózás…', 'Browse…'}" />
                    <TextBox x:Name="KeyBox" />
                </DockPanel>
                <TextBlock Grid.Row="5" Text="{l:T 'Ki importálhatja:', 'Who can import:'}" VerticalAlignment="Center" />
                <ComboBox x:Name="ModeBox" Grid.Row="5" Grid.Column="1" Margin="0,3" HorizontalAlignment="Stretch">
                    <ComboBoxItem Content="{l:T 'Bárki (anyone)', 'Anyone'}" />
                    <ComboBoxItem Content="{l:T 'Csak aki ismer (people-who-know-me)', 'People who know me'}" />
                </ComboBox>
                <StackPanel Grid.Row="6" Grid.ColumnSpan="2" Margin="0,8,0,0">
                    <StackPanel Orientation="Horizontal">
                        <Button Style="{StaticResource ToolButton}" Click="Test_Click" Margin="-6,0,0,0" Content="{l:T '🔌 Kapcsolat tesztelése', '🔌 Test connection'}" />
                        <TextBlock x:Name="TestResult" VerticalAlignment="Center" Margin="8,0,0,0" TextWrapping="Wrap" MaxWidth="360" />
                    </StackPanel>
                    <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource MutedText}" FontSize="11" Margin="0,6,0,0"
                               Text="{l:T 'A Macen kapcsold be: Rendszerbeállítások › Általános › Megosztás › Távoli bejelentkezés. A „Bárki” módhoz a Macen be kell jelentkezni iCloudba. A jelszót a Windows titkosítva tárolja (DPAPI).', 'On the Mac enable: System Settings › General › Sharing › Remote Login. The Anyone mode requires the Mac to be signed in to iCloud. The password is stored encrypted by Windows (DPAPI).'}" />
                </StackPanel>
            </Grid>
        </Border>

        <TextBlock Text="{l:T 'AI-generálás (Claude)', 'AI generation (Claude)'}" FontWeight="SemiBold" FontSize="14" Margin="0,16,0,0" />
        <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource MutedText}" Margin="0,4,0,6"
                   Text="{l:T 'A „Parancs leírásból” funkcióhoz egy Claude API-kulcs kell (console.anthropic.com). A leírásod és a generált parancs az Anthropic szervereire kerül. A kulcsot a Windows titkosítva tárolja; üresen hagyva az ANTHROPIC_API_KEY környezeti változót használja.', 'The Shortcut from description feature needs a Claude API key (console.anthropic.com). Your description and the generated shortcut are sent to Anthropic. The key is stored encrypted by Windows; if left empty, the ANTHROPIC_API_KEY environment variable is used.'}" />
        <PasswordBox x:Name="ClaudeKeyBox" />
        <CheckBox x:Name="UpdatesCheck" Margin="0,14,0,0"
                  Content="{l:T 'Frissítések keresése indításkor (naponta egyszer, a GitHubon)', 'Check for updates at startup (once a day, on GitHub)'}" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Style="{StaticResource PrimaryButton}" IsDefault="True" Click="Ok_Click" MinWidth="90" Content="{l:T 'Mentés', 'Save'}" />
            <Button Style="{StaticResource ToolButton}" IsCancel="True" MinWidth="80" Content="{l:T 'Mégse', 'Cancel'}" />
        </StackPanel>
    </StackPanel>
</Window>
