<Window Icon="/Assets/app.ico" x:Class="ShortcutForge.App.Views.DryRunWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:ShortcutForge.App.Services"
        Title="{l:T 'Próbafuttatás', 'Dry run'}" Width="920" Height="620" MinWidth="640" MinHeight="400"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource WindowBg}" Foreground="{DynamicResource TextFg}" FontFamily="Segoe UI" FontSize="13">
    <DockPanel Margin="14">
        <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap" Foreground="{DynamicResource MutedText}" Margin="0,0,0,10"
                   Text="{l:T 'A parancs lépésenként lefut Windowson: szöveg, számok, változók, listák, szótárak, dátumok, Ha / Ismétlés / Menü. Az iPhone-hoz kötött akciók (értesítés, rezgés…) csak megjelennek, a Windowson nem futtatható akciók (hálózat, fotók, appok…) kimaradnak. Fájl, hálózat és a valódi vágólap érintetlen marad.', 'The shortcut runs step by step on Windows: text, numbers, variables, lists, dictionaries, dates, If / Repeat / Menu. iPhone-only effects (notification, vibration…) are only shown; actions that cannot run on Windows (network, photos, apps…) are skipped. Files, the network and the real clipboard are never touched.'}" />

        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
            <Button x:Name="RunButton" DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" MinWidth="120" Margin="10,0,0,0"
                    IsDefault="True" Click="Run_Click" Content="{l:T '▶ Futtatás', '▶ Run'}" />
            <TextBlock DockPanel.Dock="Left" VerticalAlignment="Center" Margin="0,0,8,0" Text="{l:T 'Parancs bemenete:', 'Shortcut input:'}" />
            <TextBox x:Name="InputBox" VerticalContentAlignment="Center"
                     ToolTip="{l:T 'Ezt kapja a Parancs bemenete (ShortcutInput) változó. Üresen is futtatható.', 'This is what the Shortcut Input variable receives. Can be left empty.'}" />
        </DockPanel>

        <Border DockPanel.Dock="Bottom" Margin="0,10,0,0" Padding="10,8" CornerRadius="6" Background="{DynamicResource PanelBg}"
                BorderBrush="{DynamicResource CardBorder}" BorderThickness="1">
            <DockPanel>
                <Button DockPanel.Dock="Right" Style="{StaticResource ToolButton}" MinWidth="80" IsCancel="True" Content="{l:T 'Bezárás', 'Close'}" />
                <TextBlock x:Name="SummaryText" TextWrapping="Wrap" VerticalAlignment="Center"
                           Text="{l:T 'Nyomd meg a Futtatás gombot.', 'Press Run.'}" />
            </DockPanel>
        </Border>

        <ListView x:Name="StepList" BorderBrush="{DynamicResource CardBorder}" BorderThickness="1" Background="{DynamicResource CardBg}">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="#" Width="44" DisplayMemberBinding="{Binding Number}" />
                    <GridViewColumn Header="{l:T 'Akció', 'Action'}" Width="260">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Margin="{Binding Indent}">
                                    <TextBlock Text="{Binding Icon}" Width="22" ToolTip="{Binding KindText}" />
                                    <TextBlock Text="{Binding Action}" FontWeight="SemiBold" />
                                </StackPanel>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="{l:T 'Eredmény', 'Result'}" Width="300">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Output}" TextTrimming="CharacterEllipsis" FontFamily="Cascadia Mono, Consolas"
                                           ToolTip="{Binding Output}" />
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="{l:T 'Megjegyzés', 'Note'}" Width="260">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Note}" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource MutedText}"
                                           ToolTip="{Binding Note}" />
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                </GridView>
            </ListView.View>
        </ListView>
    </DockPanel>
</Window>
