<Window Icon="/Assets/app.ico" x:Class="ShortcutForge.App.Views.GalleryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:ShortcutForge.App.Services"
        xmlns:core="clr-namespace:ShortcutForge.Core;assembly=ShortcutForge.Core"
        xmlns:avalon="http://icsharpcode.net/sharpdevelop/avalonedit"
        Title="{l:T 'Sablongaléria', 'Template gallery'}" Width="980" Height="640" MinWidth="700" MinHeight="420"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource WindowBg}" Foreground="{DynamicResource TextFg}" FontFamily="Segoe UI" FontSize="13">
    <DockPanel Margin="14">
        <DockPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button x:Name="OpenButton" Style="{StaticResource PrimaryButton}" MinWidth="110" IsDefault="True" IsEnabled="False"
                        Click="Open_Click" Content="{l:T 'Megnyitás', 'Open'}" />
                <Button Style="{StaticResource ToolButton}" MinWidth="80" IsCancel="True" Content="{l:T 'Mégse', 'Cancel'}" />
            </StackPanel>
            <TextBlock x:Name="StatusText" VerticalAlignment="Center" Foreground="{DynamicResource MutedText}" TextWrapping="Wrap" />
        </DockPanel>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="340" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <DockPanel>
                <TextBox x:Name="SearchBox" DockPanel.Dock="Top" Margin="0,0,0,8" TextChanged="SearchBox_TextChanged"
                         ToolTip="{l:T 'Keresés a sablonok között', 'Search templates'}" />
                <ListBox x:Name="TemplateList" SelectionChanged="TemplateList_SelectionChanged" MouseDoubleClick="TemplateList_MouseDoubleClick"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type core:GalleryTemplate}">
                            <StackPanel Margin="0,3">
                                <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding DisplayDescription}" Foreground="{DynamicResource MutedText}" FontSize="11.5" TextWrapping="Wrap" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
            <Border Grid.Column="2" BorderBrush="{DynamicResource CardBorder}" BorderThickness="1" CornerRadius="6" Background="{DynamicResource EditorBg}">
                <avalon:TextEditor x:Name="Preview" IsReadOnly="True" FontFamily="Cascadia Mono, Consolas" FontSize="13" Padding="6"
                                   HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" />
            </Border>
        </Grid>
    </DockPanel>
</Window>
