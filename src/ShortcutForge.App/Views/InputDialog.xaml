<Window Icon="/Assets/app.ico" x:Class="ShortcutForge.App.Views.InputDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:ShortcutForge.App.Services"
        Width="560" SizeToContent="Height" ResizeMode="NoResize" WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False" Background="{DynamicResource WindowBg}" Foreground="{DynamicResource TextFg}"
        FontFamily="Segoe UI" FontSize="13">
    <StackPanel Margin="16">
        <TextBlock x:Name="MessageText" TextWrapping="Wrap" Margin="0,0,0,8" />
        <TextBox x:Name="ValueBox" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Style="{StaticResource PrimaryButton}" IsDefault="True" Click="Ok_Click" MinWidth="80" Content="OK" />
            <Button Style="{StaticResource ToolButton}" IsCancel="True" MinWidth="80" Content="{l:T 'Mégse', 'Cancel'}" />
        </StackPanel>
    </StackPanel>
</Window>
