<Window x:Class="ShortcutForge.App.Views.HelpWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:ShortcutForge.App.Services"
        xmlns:avalon="http://icsharpcode.net/sharpdevelop/avalonedit"
        Title="{l:T 'Szöveges nyelv (DSL) – súgó', 'Text language (DSL) – help'}" Width="840" Height="780" WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBg}" Foreground="{DynamicResource TextFg}" FontFamily="Segoe UI" FontSize="13">
    <DockPanel Margin="12">
        <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap" Margin="0,0,0,8" Foreground="{DynamicResource MutedText}"
                   Text="{l:T 'A szöveges nézet ugyanazt a parancsot írja le, mint a vizuális szerkesztő. Fülváltáskor a két nézet szinkronizálódik.', 'The text view describes the same shortcut as the visual editor. The two views are synchronized when you switch tabs.'}" />
        <Border BorderBrush="{DynamicResource CardBorder}" BorderThickness="1" CornerRadius="6" Background="{DynamicResource EditorBg}">
            <avalon:TextEditor x:Name="HelpText" IsReadOnly="True" FontFamily="Cascadia Mono, Consolas" FontSize="13" Padding="6"
                               HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" WordWrap="True" />
        </Border>
    </DockPanel>
</Window>
