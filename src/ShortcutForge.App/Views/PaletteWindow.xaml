<Window x:Class="ShortcutForge.App.Views.PaletteWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:ShortcutForge.App.Services"
        xmlns:vm="clr-namespace:ShortcutForge.App.ViewModels"
        Title="{l:T 'Parancspaletta', 'Command palette'}" Width="640" Height="440" WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="Manual" Background="{DynamicResource PanelBg}" Foreground="{DynamicResource TextFg}"
        BorderBrush="{DynamicResource CardBorder}" BorderThickness="1" FontFamily="Segoe UI" FontSize="13"
        Deactivated="Window_Deactivated">
    <DockPanel Margin="10">
        <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
            <TextBox x:Name="QueryBox" FontSize="15" Padding="30,6,6,6" TextChanged="QueryBox_TextChanged" PreviewKeyDown="QueryBox_PreviewKeyDown" />
            <TextBlock Text="&#xE721;" FontFamily="Segoe Fluent Icons" Margin="10,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"
                       Foreground="{DynamicResource MutedText}" />
            <TextBlock x:Name="Placeholder" Text="{l:T 'Parancs vagy akció keresése…  (pl. alert, export, sötét)', 'Search commands and actions…  (e.g. alert, export, dark)'}"
                       Margin="32,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False" Foreground="{DynamicResource SubtleText}" />
        </Grid>
        <TextBlock DockPanel.Dock="Bottom" Margin="4,6,0,0" FontSize="11" Foreground="{DynamicResource MutedText}"
                   Text="{l:T '↑↓ választás · Enter futtatás · Esc bezárás', '↑↓ select · Enter run · Esc close'}" />
        <ListBox x:Name="ResultList" BorderThickness="0" Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 MouseDoubleClick="ResultList_MouseDoubleClick">
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                    <Setter Property="Padding" Value="8,4" />
                    <Setter Property="MinHeight" Value="0" />
                </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
                <DataTemplate DataType="{x:Type vm:PaletteItem}">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Left" Text="{Binding Glyph}" FontFamily="Segoe Fluent Icons" Width="26" VerticalAlignment="Center"
                                   Foreground="{DynamicResource Accent}" />
                        <TextBlock DockPanel.Dock="Right" Text="{Binding Shortcut}" Foreground="{DynamicResource MutedText}" FontSize="11" VerticalAlignment="Center" Margin="8,0,0,0" />
                        <TextBlock DockPanel.Dock="Right" Text="{Binding Category}" Foreground="{DynamicResource MutedText}" FontSize="11" VerticalAlignment="Center" Margin="8,0,0,0" />
                        <TextBlock Text="{Binding Title}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                    </DockPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </DockPanel>
</Window>
