      "params": [
        { "key": "WFInput", "name": "input", "label": "Bemenet", "type": "variable" },
        { "key": "WFPDFIncludeMargin", "name": "margin", "label": "Margó", "type": "bool" },
        { "key": "WFPDFIncludedPages", "name": "pages", "label": "Oldalak", "type": "enum", "options": [ "All Pages", "Single Page", "Page Range" ] }
      ]
    },
    {
      "id": "is.workflow.actions.gettextfrompdf", "name": "Get Text from PDF", "dsl": "GetTextFromPdf", "output": "Text from PDF",
      "params": [
        { "key": "WFInput", "name": "pdf", "label": "PDF", "type": "variable" },
        { "key": "WFGetTextFromPDFTextType", "name": "type", "label": "Típus", "type": "enum", "options": [ "Text", "Rich Text" ] }
      ]
    },
    {
      "id": "is.workflow.actions.print", "name": "Print", "dsl": "Print",
      "params": [ { "key": "WFInput", "name": "input", "label": "Bemenet", "type": "variable" } ]
    },
    {
      "id": "is.workflow.actions.share", "name": "Share", "dsl": "Share",
      "params": [ { "key": "WFInput", "name": "input", "label": "Bemenet", "type": "variable" } ]
    },
    {
      "id": "is.workflow.actions.airdropdocument", "name": "AirDrop", "dsl": "AirDrop",
      "params": [ { "key": "WFInput", "name": "input", "label": "Bemenet", "type": "variable" } ]
    },
    {
      "id": "is.workflow.actions.openin", "name": "Open File", "dsl": "OpenFile",
      "params": [
        { "key": "WFInput", "name": "file", "label": "Fájl", "type": "variable" },
        { "key": "WFOpenInAskWhenRun", "name": "ask", "label": "Kérdezze meg", "type": "bool" }
      ]
    },
    {
      "id": "is.workflow.actions.getclipboard", "name": "Get Clipboard", "dsl": "GetClipboard", "output": "Clipboard"
    },
    {
      "id": "is.workflow.actions.setclipboard", "name": "Copy to Clipboard", "dsl": "CopyToClipboard",
      "params": [
        { "key": "WFInput", "name": "input", "label": "Bemenet", "type": "text" },
        { "key": "WFLocalOnly", "name": "localOnly", "label": "Csak helyi", "type": "bool" },
        { "key": "WFExpirationDate", "name": "expires", "label": "Lejárat", "type": "text" }
      ]
    },
    {
      "id": "is.workflow.actions.detect.images", "name": "Get Images from Input", "dsl": "GetImages", "output": "Images",
      "params": [ { "key": "WFInput", "name": "input", "label": "Bemenet", "type": "variable" } ]
    },
    {
      "id": "is.workflow.actions.properties.files", "name": "Get Details of Files", "dsl": "GetFileDetails", "output": "File Details",
      "params": [
        { "key": "WFInput", "name": "file", "label": "Fájl", "type": "variable" },
        { "key": "WFContentItemPropertyName", "name": "property", "label": "Tulajdonság", "type": "enum", "options": [ "File Size", "File Extension", "Creation Date", "File Path", "Last Modified Date", "Name" ] }
      ]
