      "params": [
        { "key": "WFFolder", "name": "folder", "label": "Mappa", "type": "variable" },
        { "key": "Recursive", "name": "recursive", "label": "Almappákkal", "type": "bool" }
      ]
    },
    {
      "id": "is.workflow.actions.file.rename", "name": "Rename File", "dsl": "RenameFile", "output": "Renamed Item",
      "params": [
        { "key": "WFFile", "name": "file", "label": "Fájl", "type": "variable" },
        { "key": "WFNewFilename", "name": "name", "label": "Új név", "type": "text" }
      ]
    },
    {
      "id": "is.workflow.actions.file.move", "name": "Move File", "dsl": "MoveFile",
      "params": [
        { "key": "WFFile", "name": "file", "label": "Fájl", "type": "variable" },
        { "key": "WFFolder", "name": "destination", "label": "Cél", "type": "raw" },
        { "key": "WFReplaceExisting", "name": "replace", "label": "Felülírás", "type": "bool" }
      ]
    },
    {
      "id": "is.workflow.actions.file.reveal", "name": "Reveal Files in Finder", "dsl": "RevealInFinder", "macOnly": true,
      "params": [ { "key": "WFFile", "name": "files", "label": "Fájlok", "type": "variable" } ]
    },
    {
      "id": "is.workflow.actions.makezip", "name": "Make Archive", "dsl": "MakeArchive", "output": "Archive",
      "params": [
