        { "key": "WFAppendFileWriteMode", "name": "mode", "label": "Mód", "type": "enum", "options": [ "Append", "Prepend" ] }
      ]
    },
    {
      "id": "is.workflow.actions.file.delete", "name": "Delete Files", "dsl": "DeleteFiles",
      "params": [
        { "key": "WFInput", "name": "files", "label": "Fájlok", "type": "variable" },
