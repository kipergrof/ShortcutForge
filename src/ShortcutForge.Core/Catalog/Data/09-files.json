{
  "category": "Fájlok és dokumentumok",
  "actions": [
    {
      "id": "is.workflow.actions.documentpicker.open", "name": "Get File", "dsl": "GetFile", "output": "File",
      "params": [
        { "key": "WFShowFilePicker", "name": "showPicker", "label": "Dokumentumválasztó", "type": "bool" },
        { "key": "WFGetFilePath", "name": "path", "label": "Útvonal", "type": "text" },
        { "key": "WFFile", "name": "folder", "label": "Mappa", "type": "raw" },
        { "key": "WFFileErrorIfNotFound", "name": "errorIfNotFound", "label": "Hiba, ha nincs", "type": "bool" },
        { "key": "SelectMultiple", "name": "multiple", "label": "Több fájl", "type": "bool" }
      ]
    },
    {
      "id": "is.workflow.actions.documentpicker.save", "name": "Save File", "dsl": "SaveFile", "output": "Saved File",
      "params": [
        { "key": "WFInput", "name": "input", "label": "Fájl", "type": "variable" },
        { "key": "WFAskWhereToSave", "name": "ask", "label": "Kérdezze meg, hová", "type": "bool" },
        { "key": "WFFileDestinationPath", "name": "path", "label": "Útvonal", "type": "text" },
        { "key": "WFFolder", "name": "folder", "label": "Mappa", "type": "raw" },
        { "key": "WFSaveFileOverwrite", "name": "overwrite", "label": "Felülírás", "type": "bool" }
      ]
    },
    {
