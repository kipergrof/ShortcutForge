      "params": [
        { "key": "WFContactFirstName", "name": "firstName", "label": "Keresztnév", "type": "text" },
        { "key": "WFContactLastName", "name": "lastName", "label": "Vezetéknév", "type": "text" },
        { "key": "WFContactCompany", "name": "company", "label": "Cég", "type": "text" },
        { "key": "WFContactNotes", "name": "notes", "label": "Jegyzet", "type": "text" },
        { "key": "ShowWhenRun", "name": "showWhenRun", "label": "Megjelenítés futáskor", "type": "bool" }
      ]
    },
    {
      "id": "is.workflow.actions.appendnote", "name": "Append to Note", "dsl": "AppendToNote",
      "params": [
        { "key": "WFNote", "name": "note", "label": "Jegyzet", "type": "raw" },
        { "key": "WFInput", "name": "text", "label": "Szöveg", "type": "text" }
      ]
    },
    {
      "id": "com.apple.mobilenotes.SharingExtension", "name": "Create Note", "dsl": "CreateNote",
      "params": [
        { "key": "WFCreateNoteInput", "name": "body", "label": "Szöveg", "type": "text" },
        { "key": "ShowWhenRun", "name": "showWhenRun", "label": "Megjelenítés futáskor", "type": "bool" }
      ]
    },
    {
      "id": "is.workflow.actions.shownote", "name": "Show Note", "dsl": "ShowNote",
      "params": [ { "key": "WFInput", "name": "note", "label": "Jegyzet", "type": "variable" } ]
    },
    {
      "id": "is.workflow.actions.homeaccessory", "name": "Control Home", "dsl": "ControlHome",
      "params": [
        { "key": "WFHomeName", "name": "home", "label": "Otthon", "type": "string" },
        { "key": "WFHomeSceneName", "name": "scene", "label": "Jelenet", "type": "string" }
      ]
    },
    {
      "id": "is.workflow.actions.runsshscript", "name": "Run Script over SSH", "dsl": "RunSSH", "output": "Shell Script Result",
      "params": [
        { "key": "WFSSHHost", "name": "host", "label": "Hoszt", "type": "text" },
        { "key": "WFSSHPort", "name": "port", "label": "Port", "type": "text" },
        { "key": "WFSSHUser", "name": "user", "label": "Felhasználó", "type": "text" },
        { "key": "WFSSHAuthenticationType", "name": "auth", "label": "Hitelesítés", "type": "enum", "options": [ "Password", "SSH Key" ] },
        { "key": "WFSSHPassword", "name": "password", "label": "Jelszó", "type": "text" },
        { "key": "WFSSHScript", "name": "script", "label": "Szkript", "type": "text" },
        { "key": "WFInput", "name": "input", "label": "Bemenet", "type": "variable" }
      ]
    },
    {
      "id": "is.workflow.actions.runshellscript", "name": "Run Shell Script", "dsl": "RunShellScript", "output": "Shell Script Result", "macOnly": true,
      "params": [
        { "key": "Script", "name": "script", "label": "Szkript", "type": "text" },
        { "key": "Shell", "name": "shell", "label": "Shell", "type": "enum", "options": [ "zsh", "bash", "sh", "csh", "ksh", "tcsh", "python3", "ruby", "perl" ] },
        { "key": "Input", "name": "input", "label": "Bemenet", "type": "variable" },
        { "key": "InputMode", "name": "inputMode", "label": "Bemenet mód", "type": "enum", "options": [ "to stdin", "as arguments" ] }
      ]
    },
    {
      "id": "is.workflow.actions.runapplescript", "name": "Run AppleScript", "dsl": "RunAppleScript", "output": "AppleScript Result", "macOnly": true,
      "params": [
        { "key": "Script", "name": "script", "label": "Szkript", "type": "text" },
        { "key": "Input", "name": "input", "label": "Bemenet", "type": "variable" }
      ]
    },
    {
      "id": "is.workflow.actions.runjavascriptforautomation", "name": "Run JavaScript for Mac Automation", "dsl": "RunJXA", "output": "JavaScript Result", "macOnly": true,
      "params": [
        { "key": "Script", "name": "script", "label": "Szkript", "type": "text" },
        { "key": "Input", "name": "input", "label": "Bemenet", "type": "variable" }
      ]
    }
