{
  "category": "Listák és szótárak",
  "actions": [
    {
      "id": "is.workflow.actions.list", "name": "List", "dsl": "List", "output": "List",
      "params": [ { "key": "WFItems", "name": "items", "label": "Elemek", "type": "list" } ]
    },
    {
      "id": "is.workflow.actions.choosefromlist", "name": "Choose from List", "dsl": "ChooseFromList", "output": "Chosen Item",
      "params": [
        { "key": "WFInput", "name": "list", "label": "Lista", "type": "variable" },
        { "key": "WFChooseFromListActionPrompt", "name": "prompt", "label": "Kérdés", "type": "text" },
        { "key": "WFChooseFromListActionSelectMultiple", "name": "multiple", "label": "Több is választható", "type": "bool" },
        { "key": "WFChooseFromListActionSelectAll", "name": "selectAll", "label": "Alapból mind kijelölve", "type": "bool" }
      ]
    },
    {
      "id": "is.workflow.actions.getitemfromlist", "name": "Get Item from List", "dsl": "GetItemFromList", "output": "Item from List",
      "params": [
        { "key": "WFInput", "name": "list", "label": "Lista", "type": "variable" },
        { "key": "WFItemSpecifier", "name": "which", "label": "Melyik", "type": "enum", "options": [ "First Item", "Last Item", "Random Item", "Item At Index", "Items in Range" ] },
        { "key": "WFItemIndex", "name": "index", "label": "Index", "type": "number" },
        { "key": "WFItemRangeStart", "name": "start", "label": "Kezdet", "type": "number" },
        { "key": "WFItemRangeEnd", "name": "end", "label": "Vég", "type": "number" }
      ]
    },
    {
      "id": "is.workflow.actions.count", "name": "Count", "dsl": "Count", "output": "Count",
      "params": [
        { "key": "Input", "name": "input", "label": "Bemenet", "type": "variable" },
        { "key": "WFCountType", "name": "type", "label": "Mit számol", "type": "enum", "options": [ "Items", "Characters", "Words", "Sentences", "Lines" ] }
      ]
    },
    {
      "id": "is.workflow.actions.dictionary", "name": "Dictionary", "dsl": "Dictionary", "output": "Dictionary",
      "params": [ { "key": "WFItems", "name": "items", "label": "Elemek", "type": "dictionary" } ]
    },
    {
      "id": "is.workflow.actions.getvalueforkey", "name": "Get Dictionary Value", "dsl": "GetDictionaryValue", "output": "Dictionary Value",
      "params": [
        { "key": "WFInput", "name": "dictionary", "label": "Szótár", "type": "variable" },
        { "key": "WFGetDictionaryValueType", "name": "get", "label": "Mit", "type": "enum", "options": [ "Value", "All Keys", "All Values" ] },
        { "key": "WFDictionaryKey", "name": "key", "label": "Kulcs", "type": "text" }
      ]
    },
    {
      "id": "is.workflow.actions.setvalueforkey", "name": "Set Dictionary Value", "dsl": "SetDictionaryValue", "output": "Dictionary",
      "params": [
        { "key": "WFDictionary", "name": "dictionary", "label": "Szótár", "type": "variable" },
        { "key": "WFDictionaryKey", "name": "key", "label": "Kulcs", "type": "text" },
        { "key": "WFDictionaryValue", "name": "value", "label": "Érték", "type": "text" }
      ]
    },
    {
      "id": "is.workflow.actions.detect.dictionary", "name": "Get Dictionary from Input", "dsl": "GetDictionaryFromInput", "output": "Dictionary",
      "params": [ { "key": "WFInput", "name": "input", "label": "Bemenet", "type": "variable" } ]
    },
    {
      "id": "is.workflow.actions.filter.files", "name": "Filter Files", "dsl": "FilterFiles", "output": "Files",
      "params": [
        { "key": "WFContentItemInputParameter", "name": "input", "label": "Bemenet", "type": "variable" },
        { "key": "WFContentItemFilter", "name": "filter", "label": "Szűrő", "type": "raw" },
        { "key": "WFContentItemSortProperty", "name": "sortBy", "label": "Rendezés", "type": "string" },
        { "key": "WFContentItemSortOrder", "name": "order", "label": "Sorrend", "type": "string" },
        { "key": "WFContentItemLimitEnabled", "name": "limitEnabled", "label": "Korlát", "type": "bool" },
        { "key": "WFContentItemLimitNumber", "name": "limit", "label": "Korlát száma", "type": "number" }
      ]
    }
  ]
}
